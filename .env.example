APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
RAZORPAY_SSL_VERIFY=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Live gold & silver spot rates (https://www.goldapi.io)
# Never commit the real key here — put it in your local .env only.
METAL_PRICE_API_KEY=
# METAL_PRICE_CACHE_TTL=900
# METAL_PRICE_GRAMS_PER_UNIT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ═══════════════════════════════════════════════════════════════════════════
#  Storefront JSON API  (https://astroemerging.com/gehna/api/v1)
# ═══════════════════════════════════════════════════════════════════════════

# Public base URL of the shop INCLUDING the install folder, e.g.
#   https://astroemerging.com/gehna
# Every absolute URL the API returns (product/category images, product page
# links) is built from it, because the React app runs on a different origin
# and a path-only /storage/... would resolve against the React dev server.
#
# Leave this EMPTY to auto-detect the base from the incoming request, which is
# correct for local development and for production. Set it only when a reverse
# proxy makes the request's own root wrong.
STOREFRONT_URL=

# Version segment prefixed onto every JSON route.
API_VERSION=v1

# Default and maximum ?per_page= for list endpoints. The maximum is a hard
# ceiling so one request cannot pull the whole catalogue into memory.
API_PER_PAGE=12
API_PER_PAGE_MAX=60

# Browser origins allowed to call the API, comma separated.
API_CORS_ORIGINS=https://astroemerging.com,https://www.astroemerging.com,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Sanctum: hosts allowed to use cookie-based (stateful) SPA auth.
SANCTUM_STATEFUL_DOMAINS=astroemerging.com,www.astroemerging.com,localhost,localhost:5173,localhost:3000

# Prefixing tokens makes them recognisable in a public git repository.
SANCTUM_TOKEN_PREFIX=
